# Matchfile - Fastlane code signing configuration
# For more information about match, see:
#     https://docs.fastlane.tools/actions/match/

# Git repository URL for storing certificates and profiles
# 请创建一个私有的 Git 仓库来存储证书和配置文件
git_url("")

# Git branch to use
git_branch("master")

# App identifier
app_identifier("com.example.livesnap")

# Username for the git repository
# username("")

# Type of code signing (appstore, adhoc, development, enterprise)
# type("appstore")

# Storage mode (git, google_cloud, s3)
storage_mode("git")

