<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        《Claude Code实战:从Vibe Coding入门到智能体工程》书中示例代码（PART I—IV）
        统一技术栈：Java 8 + Spring Boot 2.x
        本模块汇集书中各章演示用的最小代码片段，供对照阅读与本地试跑。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>claude-code-book-examples</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>claude-code-book-examples</name>
    <description>Example snippets for the book "《Claude Code实战:从Vibe Coding入门到智能体工程》"</description>

    <properties>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        ch11 的 OrderService / CheckoutService 是"重构前反例"节选，
                        来自不同场景，对同名仓库类要求互不兼容的方法签名（同步 vs 异步），
                        刻意保留书中原貌、仅供阅读，故排除出编译。
                    -->
                    <excludes>
                        <exclude>com/example/service/OrderService.java</exclude>
                        <exclude>com/example/service/CheckoutService.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
